{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dockerfile": {
    "fileMatch": [
      "(^|/)Dockerfile$",
      "(^|/).*\\.Dockerfile$"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "labels": ["dependencies", "docker"]
    }
  ]
}
