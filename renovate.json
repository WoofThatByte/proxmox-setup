{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/).*\\.yaml$", "(^|/).*\\.yml$"],
      "matchStrings": [
        "image:\\s*[\"']?(?<depName>[^\\s:]+):(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "labels": ["dependencies", "docker"]
    }
  ]
}
